TRADING_MODE=paper
BROKER_ADAPTER=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACKNOWLEDGEMENT=
LIVE_TRADING_REQUIRED_ACK=I understand live trading can lose money

DEFAULT_SYMBOLS=XAUUSD,XAGUSD,BTCUSD,US100.std,US30.std,WTI.m,BRENT.m
DEFAULT_TIMEFRAME=1m
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_OPEN_POSITIONS=3
MAX_SYMBOL_EXPOSURE_PCT=5
MARKET_SCAN_MAX_SYMBOLS=500
MARKET_SCAN_CACHE_SECONDS=300

DATABASE_URL=postgresql+psycopg://trader:trader@postgres:5432/trader
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

NEWS_PROVIDER=auto
NEWS_API_KEY=
MT5_CALENDAR_FILE=
OPENAI_API_KEY=

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_ACCOUNT_TYPE=
MT5_TERMINAL_PATH=
MT5_ACCOUNTS_FILE=../../data/mt5-accounts.json
MT5_READ_ONLY_ENABLED=true
MT5_TIMEOUT_MS=10000
